# Razorpay Test Mode Credentials (Get from Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Mode: false to call real Razorpay test API; true for deterministic offline simulation
MOCK_PAYMENTS=true

# Cryptographic Gate Secret for HMAC-SHA256 PreAuthorizationQuoteTokens
HMAC_GATE_SECRET=razorpay_uap_gate_hmac_secret_2026
